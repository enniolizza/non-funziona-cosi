        <a class="site-logo" href="{{ relativeRoot }}pagine/home.html" aria-label="Non Funziona Così, Prima Pagina">
            <img src="{{ relativeRoot }}assets/images/logo-nonfunzionacosi.webp" alt="" width="76" height="76" decoding="async">
        </a>
        <div class="site-brand">
            {% if currentPage == "home" or currentPage == "manifesto" %}
            <h1 class="site-title"><a href="{{ relativeRoot }}pagine/home.html">Non Funziona Così</a></h1>
            {% else %}
            <a class="site-title" href="{{ relativeRoot }}pagine/home.html">Non Funziona Così</a>
            {% endif %}
