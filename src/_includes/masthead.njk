<header class="site-header">
    <div class="container">
        <a class="site-brand-link" href="{{ relativeRoot }}pagine/home.html">
            <img class="site-logo" src="{{ relativeRoot }}assets/images/logo-nonfunzionacosi.webp" alt="" width="56" height="56" decoding="async">
            <div class="site-brand">
                {% if currentPage == "home" %}
                <h1 class="site-title">Non Funziona Così</h1>
                {% else %}
                <p class="site-title">Non Funziona Così</p>
                {% endif %}
                <p class="tagline">La Verità oltre la Propaganda</p>
            </div>
        </a>
    </div>
</header>
<nav class="site-nav" aria-label="Menu Principale">
    <ul>
        <li><a href="{{ relativeRoot }}pagine/home.html"{% if currentPage == "home" %} aria-current="page"{% endif %}>Prima Pagina</a></li>
        <li><a href="{{ relativeRoot }}pagine/home.html#articoli">Articoli</a></li>
        <li><a href="{{ relativeRoot }}pagine/chi_siamo.html"{% if currentPage == "manifesto" %} aria-current="page"{% endif %}>Il Nostro Manifesto</a></li>
    </ul>
</nav>
