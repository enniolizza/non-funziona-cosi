        </div>
    </div>
</header>
<nav class="site-nav" aria-label="Menu Principale">
    <ul>
        <li><a href="{{ relativeRoot }}pagine/home.html"{% if currentPage == "home" %} aria-current="page"{% endif %}>Prima Pagina</a></li>
        <li><a href="{{ relativeRoot }}pagine/home.html#economia">Economia & Mercati</a></li>
        <li><a href="{{ relativeRoot }}pagine/home.html#geopolitica">Geopolitica</a></li>
